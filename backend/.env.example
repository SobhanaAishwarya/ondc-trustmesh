# PostgreSQL connection used by SQLAlchemy + Alembic in production/dev.
# docker-compose.dev.yml (in this folder) stands up a matching local instance.
DATABASE_URL=postgresql+psycopg://ondc:ondc@localhost:5432/ondc_ai

# Redis is used for rate-limiting and caching hot reads (trust scores, recs).
REDIS_URL=redis://localhost:6379/0

# JWT signing. Generate a real secret for anything beyond local dev, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-to-a-random-64-byte-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Origins allowed to call the API from a browser (comma-separated).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

ENVIRONMENT=development

# Fraud model: threshold above which a transaction is flagged, and where the
# trained artifact lives (see scripts/train_fraud_model.py). The default path
# resolves to ondc_blockchain_ai/trained_models/fraud_model.joblib.
FRAUD_FLAG_THRESHOLD=0.5

# Blockchain bridge (off by default — see app/blockchain/client.py).
# 1. Start a local chain:   npx hardhat node
# 2. Deploy contracts:      npx hardhat run scripts/deploy.js --network localhost
# 3. Set these to match, then set BLOCKCHAIN_ENABLED=true.
#
# BLOCKCHAIN_PRIVATE_KEY MUST be the account that deployed the contracts (the
# TrustScore.sol `owner`) — or one it explicitly authorized via
# `setReporter()` — anything else reverts with "TrustScore: not authorized".
# For Sepolia: swap BLOCKCHAIN_RPC_URL for your own Alchemy/Infura URL, set
# BLOCKCHAIN_NETWORK=sepolia, and use a funded testnet wallet's key.
BLOCKCHAIN_ENABLED=false
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_NETWORK=localhost
BLOCKCHAIN_PRIVATE_KEY=
