# Hardhat contract deployment (npx hardhat run scripts/deploy.js --network sepolia)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your-api-key
PRIVATE_KEY=your-testnet-wallet-private-key
# Optional override for the `localhost` Hardhat network (see hardhat.config.js) —
# only needed if your local chain isn't at the default http://127.0.0.1:8545
# (e.g. Ganache GUI, which defaults to 7545).
LOCAL_RPC_URL=

# docker-compose.yml — the full containerized stack (Postgres, Redis,
# backend, frontend). For running the backend directly on the host
# instead, use backend/.env.example.
POSTGRES_USER=ondc
POSTGRES_PASSWORD=ondc
POSTGRES_DB=ondc_ai

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-to-a-random-64-byte-secret

# Origin the frontend container is reachable on (see docker-compose.yml's
# frontend port mapping). Only matters if something calls the API directly
# rather than through nginx's same-origin proxy.
CORS_ORIGINS=http://localhost:8080

# Blockchain bridge inside docker-compose — off by default, see
# backend/.env.example for what each of these does.
BLOCKCHAIN_ENABLED=false
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_NETWORK=localhost
BLOCKCHAIN_PRIVATE_KEY=
